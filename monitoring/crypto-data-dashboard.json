{
  "dashboard": {
    "id": null,
    "title": "Crypto Data Service - Phase 2 Observability",
    "tags": ["crypto-data", "observability", "phase2"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 30,
    "version": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Service Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "crypto_data_http_requests_total",
            "legendFormat": "Total Requests"
          },
          {
            "expr": "rate(crypto_data_provider_requests_total[5m])",
            "legendFormat": "Provider Requests/sec"
          },
          {
            "expr": "crypto_data_global_budget_utilization_ratio",
            "legendFormat": "Budget Utilization"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          }
        }
      },
      {
        "id": 2,
        "title": "Provider Request Duration (P95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(crypto_data_provider_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{provider}} - {{chain_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "yAxes": [
          {
            "label": "Duration (seconds)",
            "min": 0
          }
        ]
      },
      {
        "id": 3,
        "title": "Provider Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_data_provider_errors_total[5m])",
            "legendFormat": "{{provider}} - {{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "yAxes": [
          {
            "label": "Errors/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 4,
        "title": "Cost Tracking",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_data_provider_cost_usd_total[1h])",
            "legendFormat": "{{provider}} hourly cost"
          },
          {
            "expr": "crypto_data_monthly_cost_usd",
            "legendFormat": "{{provider}} monthly total"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "yAxes": [
          {
            "label": "Cost (USD)",
            "min": 0
          }
        ]
      },
      {
        "id": 5,
        "title": "Budget Utilization by Provider",
        "type": "bargauge",
        "targets": [
          {
            "expr": "crypto_data_provider_budget_utilization_ratio",
            "legendFormat": "{{provider}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.7},
                {"color": "red", "value": 0.9}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Worker Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "crypto_data_worker_health",
            "legendFormat": "{{worker_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1,
            "mappings": [
              {"value": 0, "text": "Unhealthy"},
              {"value": 1, "text": "Healthy"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Queue Depth",
        "type": "graph",
        "targets": [
          {
            "expr": "crypto_data_queue_depth",
            "legendFormat": "{{queue_name}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "yAxes": [
          {
            "label": "Jobs",
            "min": 0
          }
        ]
      },
      {
        "id": 8,
        "title": "Worker Job Processing Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_data_worker_jobs_processed_total[5m])",
            "legendFormat": "{{queue_name}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "yAxes": [
          {
            "label": "Jobs/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 9,
        "title": "Concurrency Limits",
        "type": "graph",
        "targets": [
          {
            "expr": "crypto_data_active_concurrent_requests",
            "legendFormat": "{{provider}} active requests"
          },
          {
            "expr": "rate(crypto_data_concurrency_limit_hits_total[5m])",
            "legendFormat": "{{provider}} limit hits/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "yAxes": [
          {
            "label": "Count",
            "min": 0
          }
        ]
      },
      {
        "id": 10,
        "title": "Cache Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_data_cache_hits_total[5m])",
            "legendFormat": "{{source}} hits/sec"
          },
          {
            "expr": "rate(crypto_data_cache_misses_total[5m])",
            "legendFormat": "{{source}} misses/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "yAxes": [
          {
            "label": "Operations/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 11,
        "title": "Provider Retry Attempts",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(crypto_data_provider_retry_attempts_bucket[5m])",
            "legendFormat": "{{provider}} - {{chain_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48},
        "heatmap": {
          "xBucketSize": "1m",
          "yBucketSize": 1
        }
      },
      {
        "id": 12,
        "title": "HTTP Request Volume",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_data_http_requests_total[5m])",
            "legendFormat": "{{method}} {{route}} ({{status_code}})"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 13,
        "title": "HTTP Response Times",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(crypto_data_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(crypto_data_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(crypto_data_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
        "yAxes": [
          {
            "label": "Duration (seconds)",
            "min": 0
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "provider",
          "type": "query",
          "query": "label_values(crypto_data_provider_requests_total, provider)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "chain",
          "type": "query", 
          "query": "label_values(crypto_data_provider_requests_total, chain_id)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "type": "tags",
          "tags": ["deployment"]
        }
      ]
    }
  }
}