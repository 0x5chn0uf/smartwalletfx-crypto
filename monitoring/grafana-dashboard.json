{
  "dashboard": {
    "id": null,
    "title": "Crypto Data Service - Event-Driven Architecture",
    "tags": ["crypto", "defi", "event-driven", "portfolio"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Event Bus Metrics",
        "type": "row",
        "collapsed": false,
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Events Published/Consumed",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(events_published_total[5m])",
            "legendFormat": "Published - {{type}}"
          },
          {
            "expr": "rate(events_consumed_total[5m])",
            "legendFormat": "Consumed - {{type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
        "yAxes": [
          {"label": "Events/sec", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 3,
        "title": "Event Processing Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, event_latency_ms_bucket)",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, event_latency_ms_bucket)",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
        "yAxes": [
          {"label": "Latency (ms)", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 4,
        "title": "Portfolio Processing Metrics",
        "type": "row",
        "collapsed": false,
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
      },
      {
        "id": 5,
        "title": "Worker Job Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, worker_job_duration_ms_bucket{name=\"portfolioWorker\"})",
            "legendFormat": "Portfolio Worker P95"
          },
          {
            "expr": "histogram_quantile(0.50, worker_job_duration_ms_bucket{name=\"portfolioWorker\"})",
            "legendFormat": "Portfolio Worker P50"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
        "yAxes": [
          {"label": "Duration (ms)", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 6,
        "title": "Async Request Status",
        "type": "piechart",
        "targets": [
          {
            "expr": "async_portfolio_requests_total",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10}
      },
      {
        "id": 7,
        "title": "Cost Optimization Metrics",
        "type": "row",
        "collapsed": false,
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
      },
      {
        "id": 8,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m])) * 100",
            "legendFormat": "Hit Rate %"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 19},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "API Cost per Hour",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(provider_cost_usd_total[1h])",
            "legendFormat": "$/hour"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 19},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 4
          }
        }
      },
      {
        "id": 10,
        "title": "Request Batching Efficiency",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(batched_requests_total[5m]) / rate(total_requests_total[5m]) * 100",
            "legendFormat": "Batched %"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 19},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 30},
                {"color": "green", "value": 60}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Deduplication Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(deduplicated_requests_total[5m]) / rate(total_requests_total[5m]) * 100",
            "legendFormat": "Dedupe %"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 19},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 40}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Provider Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(provider_calls_total[5m])",
            "legendFormat": "{{provider}} - {{chain}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
        "yAxes": [
          {"label": "Calls/sec", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 13,
        "title": "System Health Metrics",
        "type": "row",
        "collapsed": false,
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}
      },
      {
        "id": 14,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "5xx errors"
          },
          {
            "expr": "rate(http_requests_total{status=~\"4..\"}[5m])",
            "legendFormat": "4xx errors"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "yAxes": [
          {"label": "Errors/sec", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 15,
        "title": "Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "RSS Memory (MB)"
          },
          {
            "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
            "legendFormat": "Heap Used (MB)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "yAxes": [
          {"label": "Memory (MB)", "min": 0},
          {"show": false}
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up, instance)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "chain",
          "type": "query",
          "query": "label_values(provider_calls_total, chain)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "expr": "increase(deployment_timestamp[1m])",
          "titleFormat": "Deployment",
          "textFormat": "New deployment at {{$value}}"
        }
      ]
    }
  }
}