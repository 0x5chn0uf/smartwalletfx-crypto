# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database & Cache
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_data
REDIS_URL=redis://localhost:6379

# API Keys - External Services
ALCHEMY_API_KEY=your_alchemy_api_key_here
HELIUS_API_KEY=your_helius_api_key_here
MORALIS_API_KEY=your_moralis_api_key_here
QUICKNODE_API_KEY=your_quicknode_api_key_here
ANKR_API_KEY=your_ankr_api_key_here

# RPC URLs (use your preferred providers)
ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your-api-key
POLYGON_RPC_URL=https://polygon-mainnet.alchemyapi.io/v2/your-api-key
ARBITRUM_RPC_URL=https://arb-mainnet.alchemyapi.io/v2/your-api-key
OPTIMISM_RPC_URL=https://opt-mainnet.alchemyapi.io/v2/your-api-key
BASE_RPC_URL=https://base-mainnet.alchemyapi.io/v2/your-api-key

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
ENCRYPTION_KEY=your-super-secure-encryption-key-at-least-32-characters

# Rate Limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX=100    # requests per window

# Caching (seconds)
CACHE_TTL_SHORT=300   # 5 minutes
CACHE_TTL_MEDIUM=3600 # 1 hour
CACHE_TTL_LONG=86400  # 24 hours

# Cost Management
MONTHLY_API_BUDGET=200         # USD
COST_ALERT_THRESHOLD=150       # USD
ENABLE_COST_TRACKING=true

# Monitoring & Logging
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=info  # trace, debug, info, warn, error

# CORS Origins (comma-separated)
# For production, specify your frontend domains
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production Security Settings
ENABLE_SWAGGER=true
SWAGGER_ALLOWED_IPS=  # Optional: comma-separated IP addresses or CIDR blocks
SECURITY_CONTACT_EMAIL=security@smartwalletfx.com
INCIDENT_RESPONSE_WEBHOOK=  # Optional: webhook URL for security incidents

# Security Headers
SECURITY_HEADERS_STRICT=true
CSP_REPORT_URI=  # Optional: URL to report CSP violations