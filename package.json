{
  "name": "crypto-data-service",
  "version": "1.0.0",
  "description": "High-performance Node.js microservice for crypto data retrieval and DeFi position tracking",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:debug": "NODE_ENV=development DEBUG_MODE=true tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "build:clean": "rm -rf dist && npm run build",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:edge-cases": "jest tests/edge-cases",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run docs:validate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t crypto-data-service .",
    "docker:run": "docker run -p 3000:3000 crypto-data-service",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f crypto-data-service",
    "env:validate": "tsx scripts/validate-env.ts",
    "health:check": "curl -f http://localhost:3000/health || exit 1",
    "load-test": "tsx scripts/load-test.ts",
    "load-test:stress": "tsx scripts/load-test.ts stress",
    "load-test:memory": "tsx scripts/load-test.ts memory",
    "load-test:spike": "tsx scripts/load-test.ts spike",
    "load-test:phase3": "tsx scripts/enhanced-load-test.ts",
    "load-test:resilience": "tsx scripts/provider-resilience-test.ts",
    "load-test:baseline": "tsx scripts/performance-baseline.ts",
    "load-test:memory-profile": "tsx --expose-gc scripts/memory-profiler.ts",
    "benchmark": "tsx --expose-gc scripts/benchmark.ts",
    "profile": "tsx scripts/performance-profiler.ts profile",
    "profile:load": "tsx scripts/performance-profiler.ts load",
    "profile:memory": "tsx scripts/performance-profiler.ts memory",
    "profile:memory-advanced": "tsx --expose-gc scripts/memory-profiler.ts",
    "monitoring:setup": "chmod +x monitoring/setup-monitoring.sh && ./monitoring/setup-monitoring.sh",
    "monitoring:teardown": "kubectl delete namespace monitoring --ignore-not-found=true",
    "production:check": "tsx scripts/production-readiness-check.ts",
    "performance:baseline": "tsx scripts/performance-baseline.ts",
    "performance:comprehensive": "npm run performance:baseline && npm run load-test:phase3 && npm run load-test:resilience && npm run load-test:memory-profile",
    "docs:validate": "node scripts/validate-openapi.js",
    "prepare": "husky install",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "build:api": "tsc -p tsconfig.api.json && tsc-alias -p tsconfig.api.json"
  },
  "keywords": [
    "crypto",
    "defi",
    "blockchain",
    "ethereum",
    "solana",
    "microservice",
    "typescript",
    "express"
  ],
  "author": "SmartWalletFX Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@sentry/node": "^7.92.0",
    "@sentry/profiling-node": "^1.3.5",
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.6.5",
    "bullmq": "^5.1.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "node-cron": "^3.0.3",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.0",
    "rate-limiter-flexible": "^2.4.2",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "viem": "^2.33.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "node-fetch": "^3.3.2",
    "@types/node-fetch": "^2.6.9"
  },
  "overrides": {
    "ws": "^8.17.1",
    "bigint-buffer": "^1.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
