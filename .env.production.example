# SmartWalletFX Crypto Data Service - Production Environment Configuration
# IMPORTANT: This file contains production-specific environment variables
# Copy this file to .env for production deployment and fill in actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SERVER_TIMEOUT=30000
BODY_LIMIT=10mb

# =============================================================================
# DATABASE CONFIGURATION (Production)
# =============================================================================
# Use proper SSL connection for production database
DATABASE_URL=postgresql://username:password@your-prod-db-host:5432/smartwalletfx?schema=public&sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=60000
DATABASE_SSL=true

# =============================================================================
# REDIS CONFIGURATION (Production)
# =============================================================================
# Use Redis with authentication and SSL in production
REDIS_URL=rediss://username:password@your-redis-host:6380
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY=2000
REDIS_COMMAND_TIMEOUT=10000
REDIS_MAX_MEMORY=1024mb
REDIS_KEY_PREFIX=smartwallet:crypto:prod:

# =============================================================================
# BLOCKCHAIN DATA PROVIDERS - API KEYS (Production)
# =============================================================================

# Alchemy (REQUIRED) - Use production tier
ALCHEMY_API_KEY=your_production_alchemy_api_key_here

# Additional providers for redundancy
MORALIS_API_KEY=your_production_moralis_api_key_here
QUICKNODE_API_KEY=your_production_quicknode_api_key_here
ANKR_API_KEY=your_production_ankr_api_key_here
HELIUS_API_KEY=your_production_helius_api_key_here
INFURA_API_KEY=your_production_infura_api_key_here

# =============================================================================
# NFT MARKETPLACE APIs (Production)
# =============================================================================
OPENSEA_API_KEY=your_production_opensea_api_key_here
MAGIC_EDEN_API_KEY=your_production_magic_eden_api_key_here
RESERVOIR_API_KEY=your_production_reservoir_api_key_here
NFTGO_API_KEY=your_production_nftgo_api_key_here

# =============================================================================
# DEFI DATA PROVIDERS (Production)
# =============================================================================
DEFI_LLAMA_API_KEY=your_production_defillama_api_key_here
COINGECKO_API_KEY=your_production_coingecko_api_key_here
DUNE_API_KEY=your_production_dune_api_key_here
THE_GRAPH_API_KEY=your_production_the_graph_api_key_here

# =============================================================================
# BLOCKCHAIN RPC URLS (Production)
# =============================================================================
# Use production-grade RPC endpoints with high rate limits
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_ALCHEMY_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_ALCHEMY_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_ALCHEMY_KEY
BSC_RPC_URL=https://bsc-dataseed1.binance.org/
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpc.ftm.tools/

# Solana Production
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_PRODUCTION_HELIUS_KEY
SOLANA_COMMITMENT=confirmed

# =============================================================================
# SECURITY CONFIGURATION (Production)
# =============================================================================
# Use strong, unique secrets (minimum 64 characters for JWT in production)
JWT_SECRET=your_super_secure_production_jwt_secret_key_minimum_64_characters_long_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Use strong encryption key (minimum 32 characters)
ENCRYPTION_KEY=your_secure_32_character_encryption_key_production
ENCRYPTION_ALGORITHM=aes-256-gcm

# API Key Authentication
VALID_API_KEYS=prod_api_key_1,prod_api_key_2,prod_api_key_3
API_KEY_RATE_LIMIT=5000
API_KEY_SALT=your_prod_salt_16chars

# =============================================================================
# RATE LIMITING (Production)
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
RATE_LIMIT_STORE=redis

# =============================================================================
# CACHING CONFIGURATION (Production)
# =============================================================================
CACHE_TTL_SHORT=600
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400
CACHE_TTL_STATIC=604800
CACHE_COMPRESSION=true

# =============================================================================
# CORS CONFIGURATION (Production)
# =============================================================================
# Only allow your production domains
CORS_ORIGINS=https://app.smartwalletfx.com,https://smartwalletfx.com,https://api.smartwalletfx.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# MONITORING & OBSERVABILITY (Production)
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Production logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/smartwalletfx/crypto-data.log
LOG_MAX_FILE_SIZE=100m
LOG_MAX_FILES=10

# Error Tracking (REQUIRED for production)
SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=0.1

# Health Checks
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# COST MANAGEMENT (Production)
# =============================================================================
MONTHLY_API_BUDGET=2000
COST_ALERT_THRESHOLD=1500
ENABLE_COST_TRACKING=true
COST_REPORTING_INTERVAL=3600000

# =============================================================================
# PERFORMANCE CONFIGURATION (Production)
# =============================================================================
MAX_CONCURRENT_REQUESTS=500
REQUEST_TIMEOUT=30000
GRACEFUL_SHUTDOWN_TIMEOUT=15000
SLOW_QUERY_THRESHOLD=2000

# =============================================================================
# FEATURE FLAGS (Production)
# =============================================================================
ENABLE_WEBSOCKETS=true
ENABLE_GRAPHQL=false
ENABLE_SWAGGER=false
ENABLE_CACHE_WARMING=true

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================
DEBUG_MODE=false
MOCK_EXTERNAL_APIS=false

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# ✅ All API keys are production-tier with appropriate rate limits
# ✅ JWT_SECRET and ENCRYPTION_KEY are cryptographically secure
# ✅ Database uses SSL connection with proper credentials
# ✅ Redis uses authentication and SSL
# ✅ CORS origins are restricted to your domains only
# ✅ Sentry DSN is configured for error tracking
# ✅ Log files are properly configured for log aggregation
# ✅ Rate limits are appropriate for your expected traffic
# ✅ Monthly budget alerts are set correctly
# ✅ All secrets are stored securely (not in version control)
# ✅ SSL certificates are valid and properly configured
# ✅ Backup strategies are in place for database and Redis
# ✅ Monitoring and alerting systems are configured