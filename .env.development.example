# SmartWalletFX Crypto Data Service - Development Environment Configuration
# Copy this file to .env for local development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVER_TIMEOUT=30000
BODY_LIMIT=10mb

# =============================================================================
# DATABASE CONFIGURATION (Development)
# =============================================================================
# Local PostgreSQL for development
DATABASE_URL=postgresql://smartwallet:password@localhost:5432/smartwalletfx_dev?schema=public
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=30000
DATABASE_SSL=false

# =============================================================================
# REDIS CONFIGURATION (Development)
# =============================================================================
# Local Redis for development
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_MEMORY=256mb
REDIS_KEY_PREFIX=smartwallet:crypto:dev:

# =============================================================================
# BLOCKCHAIN DATA PROVIDERS - API KEYS (Development)
# =============================================================================

# Alchemy (REQUIRED) - Use free tier for development
ALCHEMY_API_KEY=demo_key_please_replace_with_actual_key

# Optional for development - add if you have them
# MORALIS_API_KEY=your_dev_moralis_api_key_here
# QUICKNODE_API_KEY=your_dev_quicknode_api_key_here
# ANKR_API_KEY=your_dev_ankr_api_key_here
# HELIUS_API_KEY=your_dev_helius_api_key_here
# INFURA_API_KEY=your_dev_infura_api_key_here

# =============================================================================
# NFT MARKETPLACE APIs (Development)
# =============================================================================
# OPENSEA_API_KEY=your_dev_opensea_api_key_here
# MAGIC_EDEN_API_KEY=your_dev_magic_eden_api_key_here
# RESERVOIR_API_KEY=your_dev_reservoir_api_key_here
# NFTGO_API_KEY=your_dev_nftgo_api_key_here

# =============================================================================
# DEFI DATA PROVIDERS (Development)
# =============================================================================
# DEFI_LLAMA_API_KEY=your_dev_defillama_api_key_here
# COINGECKO_API_KEY=your_dev_coingecko_api_key_here
# DUNE_API_KEY=your_dev_dune_api_key_here
# THE_GRAPH_API_KEY=your_dev_the_graph_api_key_here

# =============================================================================
# BLOCKCHAIN RPC URLS (Development)
# =============================================================================
# Use free tier RPC endpoints for development
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/demo_key_please_replace
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/demo_key_please_replace
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/demo_key_please_replace
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/demo_key_please_replace
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/demo_key_please_replace

# Free public RPC endpoints for development (use with caution - may be rate limited)
# BSC_RPC_URL=https://bsc-dataseed1.binance.org/
# AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# FANTOM_RPC_URL=https://rpc.ftm.tools/

# Solana Development
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# =============================================================================
# SECURITY CONFIGURATION (Development)
# =============================================================================
# Development secrets (DO NOT use in production)
JWT_SECRET=development_jwt_secret_key_please_change_for_production_minimum_64_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=development_encryption_key_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# API Key Authentication (optional for development)
# VALID_API_KEYS=dev_api_key_1,dev_api_key_2
API_KEY_RATE_LIMIT=100
# API_KEY_SALT=dev_salt_16chars

# =============================================================================
# RATE LIMITING (Development - Relaxed)
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_STORE=memory

# =============================================================================
# CACHING CONFIGURATION (Development - Short TTLs)
# =============================================================================
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=1800
CACHE_TTL_STATIC=3600
CACHE_COMPRESSION=false

# =============================================================================
# CORS CONFIGURATION (Development - Permissive)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
CORS_CREDENTIALS=true
CORS_MAX_AGE=3600

# =============================================================================
# MONITORING & OBSERVABILITY (Development)
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Development logging (verbose)
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/crypto-data-dev.log
LOG_MAX_FILE_SIZE=50m
LOG_MAX_FILES=3

# Error Tracking (optional for development)
# SENTRY_DSN=https://your-development-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# Health Checks
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# COST MANAGEMENT (Development - Low limits)
# =============================================================================
MONTHLY_API_BUDGET=50
COST_ALERT_THRESHOLD=40
ENABLE_COST_TRACKING=true
COST_REPORTING_INTERVAL=86400000

# =============================================================================
# PERFORMANCE CONFIGURATION (Development)
# =============================================================================
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=30000
GRACEFUL_SHUTDOWN_TIMEOUT=5000
SLOW_QUERY_THRESHOLD=500

# =============================================================================
# FEATURE FLAGS (Development - All enabled for testing)
# =============================================================================
ENABLE_WEBSOCKETS=false
ENABLE_GRAPHQL=false
ENABLE_SWAGGER=true
ENABLE_CACHE_WARMING=false

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
DEBUG_MODE=true
MOCK_EXTERNAL_APIS=false

# =============================================================================
# DEVELOPMENT SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env in the project root
# 2. Replace demo API keys with your actual development keys
# 3. Start local PostgreSQL and Redis services
# 4. Run: npm run prisma:migrate to set up the database
# 5. Run: npm run env:validate to check your configuration
# 6. Run: npm run dev to start the development server
#
# Quick setup with Docker:
# 1. Run: docker-compose up -d postgres redis
# 2. Run: npm run prisma:migrate
# 3. Run: npm run dev